# PostgreSQL
POSTGRES_DB=kakeibo_dev
POSTGRES_USER=kakeibo
POSTGRES_PASSWORD=kakeibo_dev_password

# Spring Boot DataSource
# db はコンテナ内 DNS 名（docker-compose.yml のサービス名）
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/kakeibo_dev
SPRING_DATASOURCE_USERNAME=kakeibo
SPRING_DATASOURCE_PASSWORD=kakeibo_dev_password

# Vite proxy（Docker 外でローカル実行する場合は以下を有効化）
# VITE_PROXY_TARGET=http://localhost:8080
